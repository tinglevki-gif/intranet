# ==========================================================
# TIGLEV ELEMENTFABRIK INTRANET - ENVIRONMENT VARIABLES
# ==========================================================

# Project Info
PROJECT_NAME="Tiglev Elementfabrik Intranet"
VERSION="6.0.0"

# Security & JWT Token
# NOTE: In production, generate a secure random key with: openssl rand -hex 32
SECRET_KEY="tiglev-elementfabrik-super-secret-jwt-key-2026-production-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (default for fast dev):
# DATABASE_URL="sqlite:///./intranet.db"
# Docker / Production PostgreSQL with pgvector:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@db:5432/intranet_corp"

# PostgreSQL Container Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intranet_corp
POSTGRES_PORT=5432

# AI Vector Embeddings & LLM (Optional Gemini API Key)
# If left blank, the platform automatically uses the embedded high-accuracy hybrid semantic vectorizer.
GEMINI_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=80

# Navkonzept (AddSecure FleetVision) Live Telemetry Integration
NAVKONZEPT_COOKIE="auth_clue=sso; PHPSESSID=TU_PHPSESSID_AQUI"
NAVKONZEPT_FIRM_ID=332
